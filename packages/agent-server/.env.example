# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=

# DeepSeek API 地址（默认官方）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型
DEEPSEEK_MODEL=deepseek-chat

# agent-server 监听端口
PORT=3000

# manifest 通过 HTTP 拉取（可选）。配置后优先于 MANIFEST_PATH。
# 启动时拉取一次，失败不退出、按 MANIFEST_REFRESH_INTERVAL_MS 重试；成功后也按该间隔定期刷新。
# 例：MANIFEST_URL=http://localhost:5778/wc/manifest.json
MANIFEST_URL=

# 远程 manifest 拉取的重试/刷新间隔（ms，默认 60000 = 1 分钟）
# MANIFEST_REFRESH_INTERVAL_MS=60000

# manifest 为自签 HTTPS 时设为 1，跳过 TLS 校验（仅 manifest 拉取生效，不影响 DeepSeek）
# MANIFEST_INSECURE_TLS=1

# manifest 来源的本地文件绝对路径（可选，未配置 MANIFEST_URL 时生效）
# MANIFEST_PATH=/abs/path/to/manifest.json

# 远程 manifest 单次拉取超时（ms，默认 8000）
# MANIFEST_FETCH_TIMEOUT_MS=8000

# ===== 代理（服务器无法直连公网时必填；NO_PROXY 须含 manifest 主机与 localhost）=====
# HTTP_PROXY=http://10.126.138.71:3128
# HTTPS_PROXY=http://10.126.138.71:3128
# NO_PROXY=localhost,127.0.0.1,172.16.21.200

# ===== Agent 行为调参（可选，未设置时用默认值）=====
# 单轮 ReAct 最大步数（默认 6）
# MAX_AGENT_STEPS=6
# 单次 tool.call（render / call_page_method）超时 ms（默认 8000）
# TOOL_CALL_TIMEOUT_MS=8000
# wait_for_observation 等待观测的默认/上限超时 ms（默认 10000）
# OBSERVATION_WAIT_TIMEOUT_MS=10000
# 单轮 agent run 总时长上限 ms（默认 60000）
# AGENT_RUN_TIMEOUT_MS=60000
# session 空闲回收阈值 ms（默认 1800000 = 30 分钟）
# SESSION_TTL_MS=1800000
