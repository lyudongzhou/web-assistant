{
  "name": "@webassistant/vite-plugin-wc",
  "version": "0.1.1",
  "type": "module",
  "description": "由 wc.pages.json 驱动，把一个 framework 批次的容器 + 页面编译成可被 runtime 动态加载的 bundle",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@webassistant/analyzer": "workspace:^",
    "@webassistant/protocol": "workspace:^",
    "@webassistant/wc-runtime-core": "workspace:^"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.0.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
