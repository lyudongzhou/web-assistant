{
  "framework": "vue",
  "pages": [
    {
      "name": "UserList",
      "tag": "user-list",
      "path": "/users",
      "title": "用户列表",
      "component": "./UserList.vue",
      "dataSources": [
        { "match": "/api/users", "fields": ["id", "name", "role"], "maxRows": 20, "primaryKey": "id" }
      ]
    },
    { "name": "Plain", "tag": "plain", "path": "/plain", "component": "./Plain.vue" },
    {
      "name": "QueryPage",
      "tag": "query-page",
      "path": "/query",
      "component": "./QueryPage.vue",
      "query": [{ "name": "sort", "type": "string", "description": "排序字段（清单显式声明）" }]
    }
  ]
}
