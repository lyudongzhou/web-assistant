# analyzer 使用的 AI 配置（由宿主 demo-app 提供）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 助手 WebSocket 地址（agent-server）—— 只影响 SPA 构建（VITE_ 前缀才会注入 import.meta.env）
# 留空 = '/ws'：本地 dev 由 vite 代理到 ws://localhost:3000（见 vite.config.ts）
# 生产（静态站点与 agent-server 不同域，例如 Cloudflare Pages + Render）填绝对地址：
#   VITE_WS_BASE=wss://webassistant-agent.onrender.com/ws
VITE_WS_BASE=
